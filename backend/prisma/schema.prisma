generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Raridade {
  Comum
  Rara
  Lendaria
}

enum Categoria {
  Duelista
  Controlador
  Sentinela
  Iniciador
}

model Figurinha {
  id        Int       @id @default(autoincrement())
  numero    Int       @unique
  nome      String
  categoria Categoria
  raridade  Raridade
  imagem    String
  descricao String
  Album     Album?

  @@map("figurinha")
}

model Album {
  id          Int @id @default(autoincrement())
  figurinhaId Int @unique
  quantidade  Int @default(1)

  figurinha Figurinha @relation(fields: [figurinhaId], references: [id], onDelete: Cascade)

  @@map("album")
}
